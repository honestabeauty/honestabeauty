# Kang Zi Jian CMS (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only key for database maintenance, scheduled publishing and seed scripts.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel sends this value as a Bearer token to the scheduled publishing endpoint.
# Use a random secret of at least 16 characters.
CRON_SECRET=replace-with-a-long-random-secret

# Existing site env
NEXT_PUBLIC_WHATSAPP=85297709300
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-QD7KBRVNXG

# Google Search Console — pick ONE method:
# HTML tag: paste the meta tag content value only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# HTML file: exact filename from Search Console, e.g. google1234567890.html
GOOGLE_SITE_VERIFICATION_FILE=google1234567890.html
